# Copy this file to .env and adjust values for local development.
# .env is git-ignored and never committed.

# Database
# DB_PATH=./dbstate/app.db

# Users module
# USERS_MAX_PAGE_SIZE=100

# Solidgate
# Optional local-dev fallback only. Configure real keys via the in-app
# Settings panel (stored in the DB) — never commit real credentials here.
# SOLIDGATE_PUBLIC_KEY=api_pk_xxxxxxxx_xxxx_xxxx_xxxx_xxxxxxxxxxxx
# SOLIDGATE_SECRET_KEY=api_sk_xxxxxxxx_xxxx_xxxx_xxxx_xxxxxxxxxxxx
