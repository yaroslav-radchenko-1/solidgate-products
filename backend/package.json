  "scripts": {
    "postinstall": "[ \"$NODE_ENV\" = \"production\" ] || [ -f .env ] || cp .env.example .env",
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "migration:generate": "TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:revert -d src/data-source.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
